@echo off
setlocal enabledelayedexpansion

rem FujiBlast NABU PC build (z88dk +nabu, no make needed)
rem
rem   build-nabu.bat                 build r2r\nabu\fujiblast.nabu
rem   build-nabu.bat clean
rem
rem   set SERVER=host:port           the server whose rooms are listed
rem                                  (default fujinet.online:9910)
rem   set OUT=name                   the file's name (default fujiblast: name.nabu)
rem   set DEBUG=1                    debug messages on the Internet Adapter's console
rem   set TEST_SCENE=1               an offline scene (src/test.c): 1 the arena,
rem                                  2 the waiting room, 3 a round's end, 4 the game's end

rem   set Z88DK_DIR=dir\             z88dk (default c:\z88dk\)
rem   set PYTHON=python              makes gen\nabu from gfx\tms (tools\mkgfx_tms.py)
rem   set LOCAL_DIR=dir              a copy goes there, e.g. the Internet Adapter's
rem                                  folder for local .nabu files (default c:\nabu\local,
rem                                  skipped when it doesn't exist)

if "%Z88DK_DIR%"=="" set Z88DK_DIR=c:\z88dk\
set ZCCCFG=%Z88DK_DIR%lib\config\
set PATH=%Z88DK_DIR%bin;%PATH%
if "%PYTHON%"=="" set PYTHON=python
if "%LOCAL_DIR%"=="" set LOCAL_DIR=c:\nabu\local

set SCRIPT_DIR=%~dp0
set OUT_DIR=%SCRIPT_DIR%r2r\nabu
set OBJ_DIR=%SCRIPT_DIR%build\nabu
set GEN_DIR=%SCRIPT_DIR%gen
if "%SERVER%"=="" set SERVER=fujinet.online:9910
if "%DEBUG%"=="" set DEBUG=0
if "%OUT%"=="" set OUT=fujiblast

if /I "%~1"=="clean" goto :clean

pushd "%SCRIPT_DIR%"
echo Building FujiBlast for the NABU PC (server %SERVER%)

if not exist "%OUT_DIR%" mkdir "%OUT_DIR%"
if not exist "%OBJ_DIR%" mkdir "%OBJ_DIR%"

rem the art: the Adam's (TMS9918A), as make adam makes it
if not exist "%GEN_DIR%\nabu" mkdir "%GEN_DIR%\nabu"
if not exist "%GEN_DIR%\nabu\gfxdata.c" (
  echo Making gen\nabu from gfx\tms
  %PYTHON% tools\mkgfx_tms.py gen\nabu
  if errorlevel 1 goto :fail
)
rem and the F18A's: the VGA build's art in ECM3 (src/nabu/gfx.c draws it on an F18A or a PICO9918)
if not exist "%GEN_DIR%\nabu\gfxf18a.c" (
  echo Making gen\nabu\gfxf18a.c from gfx\vga
  %PYTHON% tools\mkgfx_f18a.py gen\nabu
  if errorlevel 1 goto :fail
)
rem and the round's music for the AY (src/nabu/sound.c); set NABU_OCTAVES=2 for the bass higher
if "%NABU_OCTAVES%"=="" set NABU_OCTAVES=1
if not exist "%GEN_DIR%\nabu\music.c" (
  echo Making gen\nabu\music.c from music\play.txt
  %PYTHON% tools\mkmus_ay.py music\play.txt gen\nabu %NABU_OCTAVES%
  if errorlevel 1 goto :fail
)

> "%GEN_DIR%\config.h" echo /* GENERATED by build-nabu.bat. */
>> "%GEN_DIR%\config.h" echo #define DEFAULT_SERVER "%SERVER%"

rem (zcc hands a define on through a shell: a string is quoted twice)
rem (upstream's options for a slow CPU: a commit copies only what changed, the seats laid
rem out only for a pass that draws, the map's scan in assembly; TOWARD_PACED: the others drawn
rem walking at about their own pace)
set CFLAGS=+nabu -vn -compiler=sdcc -SO3 -D__NABU__ -DPLAT_COMMIT_SPAN -DPLAT_FAST_SEAT -DPLAT_SEATS_WHEN_DRAWN -DPLAT_MAP_NEXT -DTOWARD_PACED -DPLAT_MUSIC -Isrc -Isrc\platform-specific -Isrc\nabu -Igen -Igen\nabu
if "%DEBUG%"=="1" set CFLAGS=!CFLAGS! -DNABU_DEBUG
if not "%TEST_SCENE%"=="" set CFLAGS=!CFLAGS! -DTEST_SCENE=%TEST_SCENE% -DTEST_ARG=0
set OBJS=

call :compile_dir src ""
if errorlevel 1 goto :fail
call :compile_dir src\nabu nabu_
if errorlevel 1 goto :fail
call :compile_dir gen\nabu gen_
if errorlevel 1 goto :fail

rem No z88dk console, stdio or screen set-up (the game draws its own text);
rem the zero-filled variables are left out of the file and cleared by the crt0.
echo Linking...
zcc +nabu -vn -compiler=sdcc -m -pragma-define:CRT_INITIALIZE_BSS=1 -pragma-define:CRT_TRIM_BSS=1 -pragma-define:CLIB_DEFAULT_SCREEN_MODE=-1 -pragma-define:CRT_ENABLE_STDIO=0 -pragma-redirect:fputc_cons=_fputc_cons_stub -create-app !OBJS! -o "%OUT_DIR%\%OUT%.nabu"
if errorlevel 1 goto :fail

for %%A in ("%OUT_DIR%\%OUT%.nabu") do set NABU_SIZE=%%~zA
echo Built %OUT_DIR%\%OUT%.nabu: !NABU_SIZE! bytes (limit 60401)
if !NABU_SIZE! GTR 60401 echo *** WARNING: over the 60401 byte limit

if exist "%LOCAL_DIR%" (
  copy /Y "%OUT_DIR%\%OUT%.nabu" "%LOCAL_DIR%\%OUT%.nabu" >nul
  echo Copied to %LOCAL_DIR%
)
popd
exit /b 0

rem (a file in src that src\nabu has too, appkey.c, is the NABU's one)
:compile_dir
for %%f in (%1\*.c %1\*.asm) do (
  set SKIP=
  if "%~2"=="" if exist "src\nabu\%%~nxf" set SKIP=1
  if not defined SKIP (
    echo   %%f
    zcc %CFLAGS% -c -o "%OBJ_DIR%\%~2%%~nf.o" "%%f"
    if errorlevel 1 exit /b 1
    set OBJS=!OBJS! "%OBJ_DIR%\%~2%%~nf.o"
  )
)
exit /b 0

:clean
rmdir /S /Q "%SCRIPT_DIR%build\nabu" 2>nul
rmdir /S /Q "%SCRIPT_DIR%r2r\nabu" 2>nul
echo Cleaned.
exit /b 0

:fail
echo *** BUILD FAILED
popd
exit /b 1
